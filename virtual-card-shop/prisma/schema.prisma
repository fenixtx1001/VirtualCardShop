generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlayerTier {
  COMMON
  SEMI_STAR
  UNLISTED_STAR
  STAR_1
  STAR_2
  STAR_3
}

enum Gradeability {
  COMMON
  GREAT
  ICONIC
}

enum GradingOrderStatus {
  PENDING
  READY
  REVEALED
  CANCELLED
  COMPLETED
}

enum AuctionStatus {
  ACTIVE
  ENDED
  COLLECTED
  CANCELLED
}

enum AuctionBidderType {
  HUMAN
  DUMMY
}

enum CardSaleType {
  SHOP
  AUCTION
}

enum CardSaleBuyerType {
  SHOP
  DUMMY
  HUMAN
}

model Set {
  id             String   @id
  year           Int?
  brand          String?
  sport          String?
  packPriceCents Int?     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cards          Card[]
}

model Product {
  id                String            @id
  year              Int?
  brand             String?
  sport             String?
  packPriceCents    Int?              @default(0)
  packsPerBox       Int?
  packImageUrl      String?
  boxImageUrl       String?
  cardsPerPack      Int?
  released          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  productSets       ProductSet[]
  sealedInventories SealedInventory[]
  dailyDeals        DailyDeal[]
  ripBoxes          RipBox[]
}

model DailyDeal {
  dateKey   String   @id
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSet {
  id                      String               @id
  productId               String
  name                    String?
  isBase                  Boolean              @default(false)
  isInsert                Boolean              @default(false)
  oddsPerPack             Int?
  commonPrice             Float?
  semiStarPrice           Float?
  unlistedStarPrice       Float?
  star1Price              Float?
  star2Price              Float?
  star3Price              Float?
  defaultGradeability     Gradeability         @default(COMMON)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  cards                   Card[]
  product                 Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  prestiges               ProductSetPrestige[]

  @@index([productId])
  @@index([defaultGradeability])
}

model Card {
  id                   Int               @id @default(autoincrement())
  setId                String
  productSetId         String?
  cardNumber           String
  player               String
  team                 String?
  position             String?
  subset               String?
  variant              String?
  bookValue            Float             @default(0)
  quantityOwned        Int               @default(0)
  frontImageUrl        String?
  backImageUrl         String?
  gradeabilityOverride Gradeability?

  productSet          ProductSet?          @relation(fields: [productSetId], references: [id])
  set                 Set                 @relation(fields: [setId], references: [id])
  ownerships          CardOwnership[]
  gradingOrders       GradingOrder[]
  favoritedBy         CardFavorite[]
  shopOffers          ShopOffer[]
  shopInventory       ShopInventory?
  shopTransactions    ShopTransaction[]
  ripBoxCards         RipBoxCard[]
  ripBoxGradingOrders RipBoxGradingOrder[]
  auctions            Auction[]
  saleHistory         CardSaleHistory[]

  @@unique([setId, cardNumber])
  @@unique([productSetId, cardNumber])
  @@index([setId])
  @@index([player])
  @@index([productSetId])
  @@index([gradeabilityOverride])
}

model PlayerTierProfile {
  id             Int        @id @default(autoincrement())
  sport          String     @default("")
  canonicalName  String
  normalizedName String
  tier           PlayerTier?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([sport, normalizedName])
  @@index([sport])
  @@index([normalizedName])
  @@index([tier])
}

model PlayerTierIgnoreToken {
  id              Int      @id @default(autoincrement())
  token           String
  normalizedToken String   @unique
  isEnabled       Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isEnabled])
}

model User {
  id String @id @default(cuid())

  email               String?              @unique
  name                String?
  image               String?
  emailVerified       DateTime?
  productSetPrestiges ProductSetPrestige[]

  balanceCents Int       @default(5000)
  nextRewardAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardOwnerships          CardOwnership[]
  gradingOrders           GradingOrder[]
  sealedInventory         SealedInventory[]
  favorites               CardFavorite[]
  shopOffers              ShopOffer[]
  shopTransactions        ShopTransaction[]
  financialTransactions   FinancialTransaction[]
  financialDailySnapshots FinancialDailySnapshot[]
  ripBoxes                RipBox[]
  auctionListings         Auction[]         @relation("AuctionSeller")
  auctionWins             Auction[]         @relation("AuctionWinner")
  auctionBids             AuctionBid[]
  cardSalesSold           CardSaleHistory[] @relation("CardSaleSeller")
  cardSalesBought         CardSaleHistory[] @relation("CardSaleBuyer")
  accounts                Account[]
  sessions                Session[]
}

model SealedInventory {
  id         Int      @id @default(autoincrement())
  userId     String
  productId  String
  packsOwned Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model RipBox {
  id                 Int      @id @default(autoincrement())
  userId             String
  productId          String
  purchaseBatchId    String
  purchasePriceCents Int
  packsPurchased     Int
  packsOpened        Int      @default(0)
  isClosed           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  ripBoxCards  RipBoxCard[]
  gradingLinks RipBoxGradingOrder[]

  @@index([userId, createdAt])
  @@index([userId, productId])
  @@index([productId])
  @@index([purchaseBatchId])
  @@index([isClosed])
}

model RipBoxCard {
  id            Int      @id @default(autoincrement())
  ripBoxId      Int
  cardId        Int
  quantity      Int      @default(0)
  soldQuantity  Int      @default(0)
  realizedCents Int      @default(0)
  firstPulledAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ripBox RipBox @relation(fields: [ripBoxId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([ripBoxId, cardId])
  @@index([cardId])
  @@index([ripBoxId])
}

model CardOwnership {
  id       Int    @id @default(autoincrement())
  userId   String
  cardId   Int
  quantity Int    @default(0)

  // VCS grading buckets:
  // grade = 0 means raw/ungraded.
  // grade = 6-10 means VCS graded.
  grade    Int    @default(0)
  gradedAt DateTime?

  // Cards listed at auction stay visible in collection,
  // but locked quantity cannot be sold, graded, or auctioned again.
  auctionLockedQuantity Int @default(0)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, grade])
  @@index([cardId])
  @@index([userId])
  @@index([grade])
}

model GradingOrder {
  id           Int                @id @default(autoincrement())
  userId       String
  cardId       Int
  quantity     Int
  feePaidCents Int
  resultGrade  Int?
  status       GradingOrderStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  readyAt      DateTime?
  revealedAt   DateTime?
  completedAt  DateTime?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        Card                 @relation(fields: [cardId], references: [id], onDelete: Cascade)
  results     GradingOrderResult[]
  ripBoxLinks RipBoxGradingOrder[]

  @@index([userId, status])
  @@index([userId, readyAt])
  @@index([cardId])
  @@index([createdAt])
}

model GradingOrderResult {
  id             Int @id @default(autoincrement())
  gradingOrderId Int
  grade          Int
  quantity       Int

  gradingOrder GradingOrder @relation(fields: [gradingOrderId], references: [id], onDelete: Cascade)

  @@index([gradingOrderId])
  @@index([grade])
}

model RipBoxGradingOrder {
  id             Int      @id @default(autoincrement())
  ripBoxId       Int
  gradingOrderId Int      @unique
  cardId         Int
  quantity       Int
  createdAt      DateTime @default(now())

  ripBox       RipBox       @relation(fields: [ripBoxId], references: [id], onDelete: Cascade)
  gradingOrder GradingOrder @relation(fields: [gradingOrderId], references: [id], onDelete: Cascade)
  card         Card         @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([ripBoxId])
  @@index([cardId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CardFavorite {
  id        Int      @id @default(autoincrement())
  userId    String
  cardId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId], name: "userId_cardId")
  @@index([cardId])
  @@index([userId])
}

model ProductSetPrestige {
  id                 Int      @id @default(autoincrement())
  userId             String
  productSetId       String
  timesCompleted     Int      @default(0)
  claimedCompletions Int      @default(0)
  bonusAwardedCents  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSet ProductSet @relation(fields: [productSetId], references: [id], onDelete: Cascade)

  @@unique([userId, productSetId])
  @@index([productSetId])
}

model ShopOffer {
  id                 Int      @id @default(autoincrement())
  userId             String
  cardId             Int
  offerBps           Int
  createdAt          DateTime @default(now())
  expiresAt          DateTime
  acceptedAt         DateTime?
  acceptedQty        Int      @default(0)
  acceptedTotalCents Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, cardId])
  @@index([cardId])
}

model ShopInventory {
  id        Int      @id @default(autoincrement())
  cardId    Int      @unique
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([quantity])
}

model ShopTransaction {
  id           Int      @id @default(autoincrement())
  userId       String
  cardId       Int
  kind         String
  quantity     Int
  perCardCents Int
  totalCents   Int
  offerBps     Int?
  createdAt    DateTime @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  saleHistory CardSaleHistory[]

  @@index([userId, createdAt])
  @@index([cardId, createdAt])
}

model Auction {
  id           Int           @id @default(autoincrement())
  sellerUserId String
  winnerUserId String?
  cardId       Int
  grade        Int           @default(0)
  quantity     Int           @default(1)

  startingBidCents       Int
  currentBidCents        Int      @default(0)
  valueBasisCents        Int
  hiddenDummyMaxBidCents Int
  slabPremiumBps         Int      @default(0)

  status      AuctionStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  endsAt      DateTime
  endedAt     DateTime?
  collectedAt DateTime?

  seller User  @relation("AuctionSeller", fields: [sellerUserId], references: [id], onDelete: Cascade)
  winner User? @relation("AuctionWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  card   Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  bids        AuctionBid[]
  saleHistory CardSaleHistory[]

  @@index([sellerUserId, status])
  @@index([winnerUserId])
  @@index([cardId])
  @@index([grade])
  @@index([status, endsAt])
  @@index([createdAt])
}

model AuctionBid {
  id        Int               @id @default(autoincrement())
  auctionId Int
  userId    String?

  bidderType      AuctionBidderType @default(HUMAN)
  dummyBidderName String?

  // amountCents is the visible bid placed into the auction history.
  amountCents Int

  // maxBidCents supports proxy bidding for humans and dummy bidders.
  maxBidCents Int?

  createdAt DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([auctionId, createdAt])
  @@index([userId, createdAt])
  @@index([bidderType])
  @@index([amountCents])
}

model CardSaleHistory {
  id Int @id @default(autoincrement())

  cardId Int
  grade  Int @default(0)

  saleType  CardSaleType
  buyerType CardSaleBuyerType

  sellerUserId String?
  buyerUserId  String?

  salePriceCents     Int
  valueBasisCents    Int
  percentOfValueBps  Int

  auctionId          Int?
  shopTransactionId  Int?

  createdAt DateTime @default(now())

  card            Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  seller          User?            @relation("CardSaleSeller", fields: [sellerUserId], references: [id], onDelete: SetNull)
  buyer           User?            @relation("CardSaleBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  auction         Auction?         @relation(fields: [auctionId], references: [id], onDelete: SetNull)
  shopTransaction ShopTransaction? @relation(fields: [shopTransactionId], references: [id], onDelete: SetNull)

  @@index([cardId, createdAt])
  @@index([grade])
  @@index([saleType])
  @@index([buyerType])
  @@index([sellerUserId, createdAt])
  @@index([buyerUserId, createdAt])
  @@index([auctionId])
  @@index([shopTransactionId])
}

model FinancialTransaction {
  id                Int      @id @default(autoincrement())
  userId            String
  category          String
  direction         String
  amountCents       Int
  description       String?
  balanceAfterCents Int?
  metadata          Json?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([category])
  @@index([direction])
}

model FinancialDailySnapshot {
  id                   Int      @id @default(autoincrement())
  userId               String
  dateKey              String
  balanceCents         Int
  collectionValueCents Int
  netWorthCents        Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId, dateKey])
}