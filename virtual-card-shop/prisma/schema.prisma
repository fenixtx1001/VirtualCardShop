generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlayerTier {
  COMMON
  SEMI_STAR
  UNLISTED_STAR
  STAR_1
  STAR_2
  STAR_3
}

enum GradingProfile {
  COMMON_BASE
  STAR_BASE
  KEY_ROOKIE
  ICONIC_ROOKIE
  MODERN_INSERT
  RARE_MODERN_PARALLEL
  VINTAGE_STAR
}

enum GradingOrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Set {
  id             String   @id
  year           Int?
  brand          String?
  sport          String?
  packPriceCents Int?     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cards          Card[]
}

model Product {
  id                String            @id
  year              Int?
  brand             String?
  sport             String?
  packPriceCents    Int?              @default(0)
  packsPerBox       Int?
  packImageUrl      String?
  boxImageUrl       String?
  cardsPerPack      Int?
  released          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  productSets       ProductSet[]
  sealedInventories SealedInventory[]
  dailyDeals        DailyDeal[]
}

model DailyDeal {
  dateKey   String   @id
  productId String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSet {
  id                      String               @id
  productId               String
  name                    String?
  isBase                  Boolean              @default(false)
  isInsert                Boolean              @default(false)
  oddsPerPack             Int?
  commonPrice             Float?
  semiStarPrice           Float?
  unlistedStarPrice       Float?
  star1Price              Float?
  star2Price              Float?
  star3Price              Float?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  cards                   Card[]
  product                 Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  prestiges               ProductSetPrestige[]

  @@index([productId])
}

model Card {
  id               Int               @id @default(autoincrement())
  setId            String
  productSetId     String?
  cardNumber       String
  player           String
  team             String?
  position         String?
  subset           String?
  variant          String?
  bookValue        Float             @default(0)
  quantityOwned    Int               @default(0)
  frontImageUrl    String?
  backImageUrl     String?

  // VCS grading configuration.
  // gradingProfile controls how valuable grades are for this card type.
  // gradingPotential is a future tuning knob from 0-100. It can stay 0 for now.
  gradingProfile   GradingProfile    @default(COMMON_BASE)
  gradingPotential Int               @default(0)

  productSet       ProductSet?       @relation(fields: [productSetId], references: [id])
  set              Set               @relation(fields: [setId], references: [id])
  ownerships       CardOwnership[]
  gradingOrders    GradingOrder[]
  favoritedBy      CardFavorite[]
  shopOffers       ShopOffer[]
  shopInventory    ShopInventory?
  shopTransactions ShopTransaction[]

  @@unique([setId, cardNumber])
  @@unique([productSetId, cardNumber])
  @@index([setId])
  @@index([player])
  @@index([productSetId])
  @@index([gradingProfile])
  @@index([gradingPotential])
}

model PlayerTierProfile {
  id             Int        @id @default(autoincrement())
  sport          String     @default("")
  canonicalName  String
  normalizedName String
  tier           PlayerTier?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([sport, normalizedName])
  @@index([sport])
  @@index([normalizedName])
  @@index([tier])
}

model PlayerTierIgnoreToken {
  id              Int      @id @default(autoincrement())
  token           String
  normalizedToken String   @unique
  isEnabled       Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isEnabled])
}

model User {
  id String @id @default(cuid())

  email               String?              @unique
  name                String?
  image               String?
  emailVerified       DateTime?
  productSetPrestiges ProductSetPrestige[]

  balanceCents Int       @default(5000)
  nextRewardAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardOwnerships  CardOwnership[]
  gradingOrders   GradingOrder[]
  sealedInventory SealedInventory[]
  favorites CardFavorite[]
  shopOffers       ShopOffer[]
  shopTransactions ShopTransaction[]
  accounts Account[]
  sessions Session[]
}

model SealedInventory {
  id         Int      @id @default(autoincrement())
  userId     String
  productId  String
  packsOwned Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model CardOwnership {
  id       Int    @id @default(autoincrement())
  userId   String
  cardId   Int
  quantity Int    @default(0)

  // VCS grading buckets:
  // grade = 0 means raw/ungraded.
  // grade = 6-10 means VCS graded.
  // Example: user/card/grade 0 qty 8 + user/card/grade 9 qty 1 + user/card/grade 10 qty 1.
  grade    Int    @default(0)
  gradedAt DateTime?

  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, grade])
  @@index([cardId])
  @@index([userId])
  @@index([grade])
}

model GradingOrder {
  id           Int                @id @default(autoincrement())
  userId       String
  cardId       Int
  quantity     Int
  feePaidCents Int
  status       GradingOrderStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  completedAt  DateTime?

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  card    Card                 @relation(fields: [cardId], references: [id], onDelete: Cascade)
  results GradingOrderResult[]

  @@index([userId, status])
  @@index([cardId])
  @@index([createdAt])
}

model GradingOrderResult {
  id             Int @id @default(autoincrement())
  gradingOrderId Int
  grade          Int
  quantity       Int

  gradingOrder GradingOrder @relation(fields: [gradingOrderId], references: [id], onDelete: Cascade)

  @@index([gradingOrderId])
  @@index([grade])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CardFavorite {
  id        Int      @id @default(autoincrement())
  userId    String
  cardId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId], name: "userId_cardId")
  @@index([cardId])
  @@index([userId])
}

model ProductSetPrestige {
  id                 Int       @id @default(autoincrement())
  userId             String
  productSetId       String
  timesCompleted     Int       @default(0)
  claimedCompletions Int       @default(0)
  bonusAwardedCents  Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  productSet  ProductSet @relation(fields: [productSetId], references: [id], onDelete: Cascade)

  @@unique([userId, productSetId])
  @@index([productSetId])
}

model ShopOffer {
  id                 Int      @id @default(autoincrement())
  userId             String
  cardId             Int
  offerBps           Int
  createdAt          DateTime @default(now())
  expiresAt          DateTime
  acceptedAt         DateTime?
  acceptedQty        Int      @default(0)
  acceptedTotalCents Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, cardId])
  @@index([cardId])
}

model ShopInventory {
  id        Int      @id @default(autoincrement())
  cardId    Int      @unique
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([quantity])
}

model ShopTransaction {
  id           Int      @id @default(autoincrement())
  userId       String
  cardId       Int
  kind         String
  quantity     Int
  perCardCents Int
  totalCents   Int
  offerBps     Int?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([cardId, createdAt])
}